+    http_client_no_redirect, BankConnector, Challenge, ChallengeKind, ChallengeResponse,
+    ConnectContext, FetchResult, Phase, RemoteAccount, RemoteTransaction,
 };
 use crate::{
     error::{CoreError, CoreResult},
@@ -119,7 +119,8 @@ struct HttpPortal {
 impl HttpPortal {
     fn client(&mut self) -> CoreResult<reqwest::Client> {
         if self.client.is_none() {
-            self.client = Some(http_client()?);
+            // Never follow redirects: the sign-in body carries the password.
+            self.client = Some(http_client_no_redirect()?);
         }
         self.client.clone().ok_or_else(bad_response)
     }
@@ -326,6 +327,22 @@ impl Portal for HttpPortal {
         }
         Ok(out)
     }
+
+    /// `POST AuthenticationService/logout` with an empty JSON object; the
+    /// portal answers `{"Status":"Success"}`. Best effort: without a session
+    /// nothing is sent, and errors are ignored because the sync is over.
+    async fn logout(&mut self) {
+        if self.token.is_some() || self.request_key.is_some() {
+            let _ = self
+                .call(true, "AuthenticationService/logout", Some(json!({})), None)
+                .await;
+        }
+        self.token = None;
+        self.request_key = None;
+        self.push_key = None;
+        // Drops the cookie jar with the session cookies.
+        self.client = None;
+    }
 }
 
