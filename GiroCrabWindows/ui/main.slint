import { Button, ListView, LineEdit, Palette, ComboBox, CheckBox, TextEdit, Switch, ScrollView } from "std-widgets.slint";
import { TagRow, SplitRow, BudgetRow, TemplateRow, TagsPanel, SplitsPanel, BudgetsPanel, TemplatesPanel } from "tags_dialog.slint";
export { TagRow, SplitRow, BudgetRow, TemplateRow }
import { RecLine, RecurringPanel } from "recurring_dialog.slint";
import { GroupsState, GroupsPanel } from "groups_dialog.slint";
import { AssetsState, AssetsLoansPanel } from "assets_loans_dialog.slint";
export { GroupsState }
export { AssetsState }
export { RecLine }

export struct AccountRow { id: int, name: string, bank: string, iban: string, header: string, monogram: string, dot: color, balance: string, currency: string, negative: bool, archived: bool }
export struct CategoryRow { id: int, name: string, depth: int, color: color }
export struct BookingRow { id: int, checked: bool, counterparty: string, account: string, category: string, category-color: color, detail: string, amount: string, negative: bool, monogram: string, tint: color, logo: image, has-logo: bool }
export struct DayGroup { title: string, sum: string, negative: bool, rows: [BookingRow] }
export struct BarGroup { label: string, income: float, expense: float }
export struct BudgetLine { name: string, amount: string, progress: float, color: color, over: bool }
export struct TileRow { index: int, name: string, color: color }
export struct SideRow { kind: int, key: string, label: string, detail: string, badge: string, amount: string, negative: bool, progress: float, dot: color, has-dot: bool, icon: string, depth: int, fold: int }
export struct TableRow { id: int, c0: string, c1: string, c2: string, c3: string, c4: string, negative: bool }
export struct KpiTile { label: string, value: string, negative: bool }
export struct ShareBar { label: string, value: string, share: float, color: color }
export struct RuleItem { title: string, detail: string }
export struct BankHit { name: string, detail: string }
export struct InspectorData { counterparty: string, iban: string, purpose: string, booking-date: string, value-date: string, account: string, amount: string, note: string, read-only: bool, monogram: string, tint: color, logo: image, has-logo: bool, subtitle: string, recurring: bool }

global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window: dark ? #0f1218 : #f5f5f7;
    out property <color> surface: dark ? #161b22 : #ffffff;
    out property <color> sidebar: dark ? #161b22 : #ececf0;
    out property <color> selected: dark ? #1f2633 : #e3e8f4;
    out property <color> border: dark ? #262c36 : #dcdce1;
    out property <color> control-border: dark ? #2a2f3a : #d0d0d6;
    out property <color> text: dark ? #f0f4f8 : #1d1d1f;
    out property <color> amount: dark ? #e6edf3 : #1d1d1f;
    out property <color> muted: dark ? #8b949e : #6e6e73;
    out property <color> accent: #388bfd;
    out property <color> primary: #2f6feb;
    out property <color> positive: dark ? #3fb950 : #1e8449;
    out property <color> negative: dark ? #f47067 : #c0392b;
}

// Vector icons (16x16 viewbox, 1.5px strokes). Unknown names draw nothing.
component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Theme.muted;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands:
        name == "bank" ? "M 2 6 L 8 2 L 14 6 Z M 3.5 8 L 3.5 12 M 6.5 8 L 6.5 12 M 9.5 8 L 9.5 12 M 12.5 8 L 12.5 12 M 2 14 L 14 14"
        : name == "card" ? "M 2.5 4 L 13.5 4 L 13.5 12 L 2.5 12 Z M 2.5 7 L 13.5 7 M 4.5 10 L 7 10"
        : name == "house" ? "M 2 8 L 8 2.5 L 14 8 M 3.5 7 L 3.5 13.5 L 12.5 13.5 L 12.5 7 M 6.5 13.5 L 6.5 9.5 L 9.5 9.5 L 9.5 13.5"
        : name == "banknote" ? "M 1.5 4.5 L 14.5 4.5 L 14.5 11.5 L 1.5 11.5 Z M 6 8 A 2 2 0 1 0 10 8 A 2 2 0 1 0 6 8"
        : name == "chart" ? "M 2.5 2.5 L 13.5 2.5 L 13.5 13.5 L 2.5 13.5 Z M 4.5 10.5 L 7 7.5 L 9 9 L 11.5 5.5"
        : name == "diamond" ? "M 8 2 L 13.5 6.5 L 8 14 L 2.5 6.5 Z M 2.5 6.5 L 13.5 6.5"
        : name == "inbox" ? "M 2 9 L 4 3 L 12 3 L 14 9 L 14 13 L 2 13 Z M 2 9 L 5.5 9 L 6.5 10.5 L 9.5 10.5 L 10.5 9 L 14 9"
        : name == "pie" ? "M 2 8 A 6 6 0 1 0 14 8 A 6 6 0 1 0 2 8 M 8 2 L 8 8 L 12.2 12.2"
        : name == "grid" ? "M 2.5 2.5 L 7 2.5 L 7 7 L 2.5 7 Z M 9 2.5 L 13.5 2.5 L 13.5 7 L 9 7 Z M 2.5 9 L 7 9 L 7 13.5 L 2.5 13.5 Z M 9 9 L 13.5 9 L 13.5 13.5 L 9 13.5 Z"
        : name == "person" ? "M 5.5 5 A 2.5 2.5 0 1 0 10.5 5 A 2.5 2.5 0 1 0 5.5 5 M 2.5 14 C 2.5 10.5 5 9.5 8 9.5 C 11 9.5 13.5 10.5 13.5 14"
        : name == "clock" ? "M 2 8 A 6 6 0 1 0 14 8 A 6 6 0 1 0 2 8 M 8 4.5 L 8 8 L 10.5 9.5"
        : name == "calendar" ? "M 2.5 3.5 L 13.5 3.5 L 13.5 13.5 L 2.5 13.5 Z M 2.5 6.5 L 13.5 6.5 M 5.5 2 L 5.5 5 M 10.5 2 L 10.5 5"
        : name == "arrow-in" ? "M 9 2.5 L 13.5 2.5 L 13.5 13.5 L 9 13.5 M 2 8 L 10 8 M 7 5 L 10 8 L 7 11"
        : name == "document" ? "M 4 2 L 9.5 2 L 12.5 5 L 12.5 14 L 4 14 Z M 9.5 2 L 9.5 5 L 12.5 5 M 6 8 L 10.5 8 M 6 10.5 L 10.5 10.5"
        : name == "folder" ? "M 2 4 L 6.5 4 L 8 5.5 L 14 5.5 L 14 12.5 L 2 12.5 Z"
        : name == "search" ? "M 2.5 7 A 4.5 4.5 0 1 0 11.5 7 A 4.5 4.5 0 1 0 2.5 7 M 10.5 10.5 L 14 14"
        : "";
}

// Disclosure chevron (12x12 viewbox): down when expanded, right when collapsed.
component Chevron inherits Path {
    in property <bool> expanded;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    fill: transparent;
    stroke: #8b949e;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: expanded ? "M 2 4 L 6 8 L 10 4" : "M 4 2 L 8 6 L 4 10";
}

// Subtle ghost button for the toolbar and headers.
component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    width: label.preferred-width + 24px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.control-border;
    background: !enabled ? transparent : ta.pressed ? Theme.text.with-alpha(0.12) : ta.has-hover ? Theme.text.with-alpha(0.07) : Theme.surface;
    opacity: enabled ? 1 : 0.45;
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    label := Text { text: root.text; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
}

// Chip toggle replacing raw checkboxes.
component PillToggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();
    height: 30px;
    width: label.preferred-width + 40px;
    border-radius: 7px;
    border-width: 1px;
    border-color: checked ? Theme.accent : Theme.control-border;
    background: checked ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.text.with-alpha(0.07) : Theme.surface;
    ta := TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
    Rectangle { x: 12px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px; background: root.checked ? Theme.accent : Theme.muted.with-alpha(0.5); }
    label := Text { x: 26px; text: root.text; color: Theme.text; font-size: 12px; vertical-alignment: center; }
}

// One sidebar line: top item, section header, group header, account or category.
component SideLine inherits Rectangle {
    in property <SideRow> r;
    in property <bool> active;
    callback clicked();
    callback fold();
    property <bool> all-card: r.key == "all";
    property <bool> subtitle: r.kind == 3 && r.progress < 0 && r.detail != "";
    height: r.kind == 1 ? 26px : r.kind == 2 ? 22px : all-card ? 34px : r.progress >= 0 ? 40px : subtitle ? 40px : 30px;
    border-radius: all-card ? 7px : 8px;
    border-width: all-card ? 1px : 0px;
    border-color: Theme.border;
    background: active ? Theme.selected : all-card ? Theme.surface : (ta.has-hover && r.kind != 1 && r.kind != 2) ? Theme.text.with-alpha(0.05) : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: all-card ? 10px : 6px + max(r.depth - 1, 0) * 14px;
        padding-right: all-card ? 10px : 8px;
        padding-top: all-card ? 6px : 0px;
        padding-bottom: all-card ? 6px : 0px;
        spacing: 6px;
        if r.fold != 0: Rectangle {
            width: 16px;
            Chevron { expanded: r.fold != 2; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            if r.kind == 4: TouchArea { clicked => { root.fold(); } }
        }
        if r.fold == 0 && (r.kind == 3 || r.kind == 4): Rectangle {
            width: 16px;
        }
        if r.fold == 0 && r.kind == 3: Rectangle {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: #161b22;
            border-width: 1px;
            border-color: r.dot.with-alpha(0.22);
            Rectangle { border-radius: 6px; background: r.dot.with-alpha(0.10); }
            Icon { name: r.icon; tint: r.dot.brighter(0.3); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            if r.badge != "": Rectangle {
                width: max(badge-over.preferred-width + 8px, 16px);
                height: 16px;
                x: parent.width - self.width + 6px;
                y: -6px;
                border-radius: 8px;
                background: Theme.primary;
                border-width: 1px;
                border-color: Theme.sidebar;
                badge-over := Text { text: r.badge; color: #ffffff; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        if r.icon != "" && (r.kind == 0 || r.kind == 2): Icon {
            name: r.icon;
            y: (parent.height - self.height) / 2;
        }
        if r.fold == 0 && r.kind == 4: Rectangle {
            width: 16px;
            if r.has-dot: Rectangle { width: 9px; height: 9px; border-radius: 4.5px; background: r.dot; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: r.kind == 1 || r.kind == 2 ? r.label.to-uppercase() : r.label;
                color: r.kind == 1 || r.kind == 2 ? Theme.muted : Theme.text;
                font-size: r.kind == 1 || r.kind == 2 ? 10px : 13px;
                font-weight: r.kind == 0 || r.kind == 1 || r.kind == 2 ? 700 : 500;
                letter-spacing: r.kind == 1 || r.kind == 2 ? 0.8px : 0px;
                overflow: elide;
            }
            if r.progress >= 0: HorizontalLayout {
                height: 14px;
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 4px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: #21262d;
                    Rectangle { x: 0px; width: parent.width * r.progress; border-radius: 2px; background: #6e7681; }
                }
                Text { text: r.detail; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
            }
            if subtitle: Text { text: r.detail; color: Theme.muted; font-size: r.progress >= 0 ? 10px : 11px; overflow: elide; }
        }
        if r.badge != "" && r.kind != 3: Rectangle {
            width: max(badge-text.preferred-width + 12px, 20px);
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: Theme.accent.with-alpha(0.2);
            badge-text := Text { text: r.badge; color: Theme.accent; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        if r.amount != "": Text {
            text: r.amount;
            color: r.negative ? Theme.negative : Theme.muted;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// Simple segmented button used by the sidebar mode switcher and the data pane tabs.
component SegButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    height: 28px;
    border-radius: 7px;
    border-width: checked ? 0px : 0px;
    background: checked ? Theme.primary : ta.has-hover ? Theme.text.with-alpha(0.07) : transparent;
    horizontal-stretch: 1;
    ta := TouchArea { clicked => { root.clicked(); } }
    Text { text: root.text; color: checked ? #ffffff : Theme.text; font-size: 11px; font-weight: checked ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
}

component KpiCard inherits Rectangle {
    in property <KpiTile> k;
    horizontal-stretch: 1;
    height: 68px;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        alignment: center;
        Text { text: k.label; color: Theme.muted; font-size: 11px; overflow: elide; }
        Text {
            text: k.value;
            color: k.value == "Nicht verfügbar" ? Theme.muted : k.negative ? Theme.negative : Theme.text;
            font-size: k.value == "Nicht verfügbar" ? 13px : 16px;
            font-weight: 700;
            overflow: elide;
        }
    }
}

component ShareBarLine inherits HorizontalLayout {
    in property <ShareBar> s;
    spacing: 10px;
    height: 22px;
    Text { text: s.label; color: Theme.text; font-size: 12px; width: 130px; vertical-alignment: center; overflow: elide; }
    Rectangle {
        horizontal-stretch: 1;
        height: 8px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: Theme.text.with-alpha(0.1);
        Rectangle { x: 0px; width: max(parent.width * s.share, 3px); border-radius: 4px; background: s.color; }
    }
    Text { text: round(s.share * 1000) / 10 + " %"; color: Theme.muted; font-size: 11px; width: 52px; horizontal-alignment: right; vertical-alignment: center; }
    Text { text: s.value; color: Theme.text; font-size: 12px; font-weight: 600; width: 110px; horizontal-alignment: right; vertical-alignment: center; }
}

component TableLine inherits Rectangle {
    in property <TableRow> data;
    in property <bool> active;
    in property <bool> clickable: false;
    callback clicked();
    height: 34px;
    background: active ? Theme.selected : ta.has-hover && clickable ? Theme.text.with-alpha(0.04) : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        Text { text: data.c0; color: Theme.text; font-size: 12px; font-weight: 600; horizontal-stretch: 3; vertical-alignment: center; overflow: elide; }
        Text { text: data.c1; color: Theme.muted; font-size: 12px; horizontal-stretch: 2; vertical-alignment: center; overflow: elide; }
        Text { text: data.c2; color: Theme.text; font-size: 12px; horizontal-stretch: 2; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        Text { text: data.c3; color: Theme.text; font-size: 12px; horizontal-stretch: 2; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        Text { text: data.c4; color: data.negative ? Theme.negative : Theme.muted; font-size: 12px; horizontal-stretch: 2; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    }
}

component TableHeader inherits Rectangle {
    in property <[string]> columns;
    height: 28px;
    background: Theme.text.with-alpha(0.04);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        Text { text: columns.length > 0 ? columns[0] : ""; color: Theme.muted; font-size: 11px; font-weight: 700; horizontal-stretch: 3; vertical-alignment: center; }
        Text { text: columns.length > 1 ? columns[1] : ""; color: Theme.muted; font-size: 11px; font-weight: 700; horizontal-stretch: 2; vertical-alignment: center; }
        Text { text: columns.length > 2 ? columns[2] : ""; color: Theme.muted; font-size: 11px; font-weight: 700; horizontal-stretch: 2; horizontal-alignment: right; vertical-alignment: center; }
        Text { text: columns.length > 3 ? columns[3] : ""; color: Theme.muted; font-size: 11px; font-weight: 700; horizontal-stretch: 2; horizontal-alignment: right; vertical-alignment: center; }
        Text { text: columns.length > 4 ? columns[4] : ""; color: Theme.muted; font-size: 11px; font-weight: 700; horizontal-stretch: 2; horizontal-alignment: right; vertical-alignment: center; }
    }
}

// Real merchant logo (rounded) or, without one, the two-letter monogram on a tinted tile.
component MerchantAvatar inherits Rectangle {
    in property <length> size: 34px;
    in property <image> logo;
    in property <bool> has-logo;
    in property <string> monogram;
    in property <color> tint;
    width: size;
    height: size;
    border-radius: 8px;
    clip: true;
    background: has-logo ? #ffffff : tint.with-alpha(0.18);
    if has-logo: Image {
        source: root.logo;
        width: root.size - 6px;
        height: root.size - 6px;
        x: 3px;
        y: 3px;
        image-fit: contain;
    }
    if !has-logo: Text {
        text: root.monogram;
        color: Theme.dark ? root.tint.brighter(0.5) : root.tint.darker(0.3);
        font-size: root.size * 0.36;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BookingLine inherits Rectangle {
    in property <BookingRow> b;
    in property <bool> active;
    callback clicked();
    height: 56px;
    background: active ? #1d3557.with-alpha(Theme.dark ? 1.0 : 0.16) : ta.has-hover ? Theme.text.with-alpha(0.04) : transparent;
    border-radius: 8px;
    if active: Rectangle { x: 0px; width: 3px; height: parent.height - 16px; y: 8px; border-radius: 1.5px; background: #2563eb; }
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        MerchantAvatar {
            y: (parent.height - self.height) / 2;
            logo: b.logo;
            has-logo: b.has-logo;
            monogram: b.monogram;
            tint: b.tint;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: b.checked ? "✓" : ""; color: Theme.positive; font-size: 11px; width: b.checked ? 12px : 0px; }
                Text { text: b.counterparty; color: Theme.text; font-size: 13px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                Text { text: b.account; color: Theme.muted; font-size: 11px; overflow: elide; max-width: 140px; }
                Text { text: "·"; color: Theme.muted; font-size: 11px; }
                Text { text: b.category; color: Theme.dark ? b.category-color.brighter(0.4) : b.category-color.darker(0.3); font-size: 11px; font-weight: 600; overflow: elide; max-width: 160px; }
                if b.detail != "": Text { text: "·"; color: Theme.muted; font-size: 11px; }
                if b.detail != "": Text { text: b.detail; color: Theme.muted; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
                if b.detail == "": Rectangle { horizontal-stretch: 1; }
            }
        }
        Text {
            text: b.amount;
            color: b.negative ? Theme.amount : Theme.positive;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// One day of bookings: rounded card with the weekday/date and the day's net sum in its header.
component DayCard inherits Rectangle {
    in property <DayGroup> day;
    in property <int> selected-booking;
    callback select(int);
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 6px;
        spacing: 0px;
        Rectangle {
            height: 34px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text { text: day.title; color: Theme.text; font-size: 13px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: day.sum; color: day.negative ? Theme.muted : Theme.positive; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; }
            }
        }
        for b in day.rows: BookingLine {
            b: b;
            active: root.selected-booking == b.id;
            clicked => { root.select(b.id); }
        }
    }
}

component BudgetBar inherits Rectangle {
    in property <BudgetLine> l;
    height: 30px;
    VerticalLayout {
        spacing: 4px;
        alignment: center;
        HorizontalLayout {
            Text { text: l.name; color: Theme.text; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
            Text { text: l.amount; color: l.over ? Theme.negative : Theme.muted; font-size: 11px; horizontal-alignment: right; }
        }
        Rectangle {
            height: 5px;
            border-radius: 2.5px;
            background: Theme.text.with-alpha(0.08);
            Rectangle { x: 0px; width: parent.width * min(max(l.progress, 0.02), 1.0); border-radius: 2.5px; background: l.over ? Theme.negative : l.color; }
        }
    }
}

// Cashflow card: period switch, legend and a dual-bar chart (income blue, expenses orange).
component CashflowCard inherits Rectangle {
    in property <[BarGroup]> bars;
    in property <[string]> ticks;
    in-out property <int> period: 0;
    callback changed();
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Text { text: "Cashflow"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "●"; color: #388bfd; font-size: 9px; vertical-alignment: center; }
            Text { text: "Einnahmen"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            Text { text: "●"; color: #d97706; font-size: 9px; vertical-alignment: center; }
            Text { text: "Ausgaben"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            for label[i] in ["Monat", "Quartal", "Jahr"]: SegButton {
                text: label;
                checked: root.period == i;
                width: 62px;
                horizontal-stretch: 0;
                clicked => { root.period = i; root.changed(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Rectangle {
                width: 46px;
                for t[i] in root.ticks: Text {
                    y: i * (parent.height - 16px) / max(root.ticks.length - 1, 1) - 7px;
                    width: parent.width;
                    text: t;
                    color: Theme.muted;
                    font-size: 9px;
                    horizontal-alignment: right;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                for t[i] in root.ticks: Rectangle {
                    y: i * (parent.height - 16px) / max(root.ticks.length - 1, 1);
                    height: 1px;
                    background: Theme.text.with-alpha(0.07);
                }
                HorizontalLayout {
                    padding-bottom: 0px;
                    for g in root.bars: Rectangle {
                        property <length> plot: parent.height - 16px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            Rectangle {
                                width: 18px;
                                Rectangle { y: plot - plot * g.income; height: plot * g.income; border-top-left-radius: 4px; border-top-right-radius: 4px; background: #388bfd; }
                            }
                            Rectangle {
                                width: 18px;
                                Rectangle { y: plot - plot * g.expense; height: plot * g.expense; border-top-left-radius: 4px; border-top-right-radius: 4px; background: #d97706; }
                            }
                        }
                        Text { y: parent.height - 12px; width: parent.width; text: g.label; color: Theme.muted; font-size: 10px; horizontal-alignment: center; }
                    }
                }
            }
        }
    }
}

component Swatches inherits HorizontalLayout {
    in property <[color]> colors;
    in-out property <int> choice: -1;
    spacing: 6px;
    alignment: start;
    for c[i] in root.colors: Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: c;
        border-width: root.choice == i ? 3px : 1px;
        border-color: root.choice == i ? Theme.text : Theme.border;
        TouchArea { clicked => { root.choice = i; } }
    }
}

// Zero-size helper: runs `fire` whenever `tick` changes (a LineEdit inside an `if` cannot be
// reached by id from the window's public functions).
component ChangeTrigger inherits Rectangle {
    in property <int> tick;
    callback fire();
    width: 0px;
    height: 0px;
    changed tick => { root.fire(); }
}

component Dialog inherits Rectangle {
    in property <length> dialog-width: 460px;
    background: #00000088;
    TouchArea { }
    Rectangle {
        width: min(root.dialog-width, parent.width - 32px);
        height: min(col.preferred-height + 4px, parent.height - 32px);
        background: Theme.surface;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border;
        col := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            @children
        }
    }
}

export component MainWindow inherits Window {
    title: "GiroCrab";
    icon: @image-url("../../docs/assets/app-icon.png");
    forward-focus: fs;
    min-width: 1040px;
    min-height: 600px;
    background: Theme.window;

    in property <bool> unlocked: false;
    in property <bool> first-run: false;
    in property <string> message;
    in property <string> sync-status;
    in property <string> total;
    in property <bool> busy: false;
    in property <[AccountRow]> accounts;
    in property <[DayGroup]> days;
    in property <[BarGroup]> cashflow-bars;
    in property <[string]> cashflow-ticks;
    in-out property <int> cashflow-period: 0;
    in property <[BudgetLine]> budget-lines;
    in property <string> budget-title: "Monatsbudgets";
    in property <[TileRow]> category-tiles;
    callback cashflow-changed();
    in property <string> selected-name;
    in property <string> selected-balance;
    in property <string> selected-currency;
    in-out property <int> selected: -1;
    in-out property <string> search-text;

    // "Bank / Konto hinzufügen" dialog
    in-out property <bool> add-open: false;
    in property <[BankHit]> bank-hits;
    in-out property <int> bank-choice: -1;
    in-out property <string> add-status;
    in property <bool> add-busy: false;

    // daily driver: filter bar, inspector, privacy, import, transfer
    in-out property <bool> privacy: false;
    in-out property <bool> uncategorized-only: false;
    in-out property <int> status-index: 0;
    in property <int> selected-booking: -1;
    in property <bool> has-inspector: false;
    in property <InspectorData> inspector;
    in property <[string]> category-names;
    in-out property <int> inspector-category: 0;
    in-out property <bool> inspector-checked: false;
    in-out property <string> note-text;
    in-out property <bool> transfer-open: false;
    in property <[string]> transfer-accounts;
    in-out property <string> transfer-status;
    // ---- navigation and views (views_ui.rs)
    in property <[SideRow]> side-rows;
    in-out property <string> side-selected: "all";
    in-out property <int> group-mode: 0;
    in-out property <string> side-query;
    callback side-click(string);
    callback side-fold(string);
    callback side-controls-changed();
    // 0 = bookings, 1 = depot / Sachwerte, 2 = Vermögen, 3 = Geplant, 4 = Lastschriften, 5 = Belege
    in property <int> view-mode: 0;
    in property <string> view-title;
    in property <string> view-total;
    in property <string> view-note;
    in property <string> view-status;
    in-out property <int> period-index: 0;
    in-out property <int> depot-tab: 0;
    in-out property <int> wealth-tab: 0;
    in-out property <int> interval-index: 0;
    in property <[string]> period-labels;
    in property <[string]> interval-labels;
    in property <[KpiTile]> kpis;
    in property <[ShareBar]> shares;
    in property <[string]> table-columns;
    in property <[TableRow]> table-rows;
    in property <string> table-empty;
    in-out property <int> table-selected: -1;
    callback view-changed();
    callback table-select(int);
    in property <[string]> doc-accounts;
    in-out property <int> doc-account-index: 0;
    in property <bool> doc-selected: false;
    in property <bool> doc-linked: false;
    callback doc-attach();
    callback doc-open();
    callback doc-link-open();
    callback doc-unlink();
    in-out property <bool> link-open: false;
    in property <[TableRow]> link-results;
    in-out property <string> link-query;
    in property <string> link-status;
    callback link-search(string);
    callback link-pick(int);
    // ---- recurring, planned, salary (recurring_ui.rs; panel in recurring_dialog.slint)
    in-out property <bool> rc-open: false;
    in-out property <int> rc-tab: 0;
    in property <string> rc-status;
    in property <string> rc-salary-cycle;
    in property <bool> rc-has-booking: false;
    in property <string> rc-booking-title;
    in property <string> rc-series-text;
    in property <string> rc-salary-state;
    in property <bool> rc-can-salary: false;
    in property <bool> rc-has-series: false;
    in property <[string]> rc-interval-names;
    in-out property <int> rc-interval: 0;
    in-out property <string> rc-custom-dates;
    in property <string> rc-month-summary;
    in property <[RecLine]> rc-month-rows;
    in property <[RecLine]> rc-ignored-rows;
    in property <string> rc-planned-summary;
    in property <[RecLine]> rc-planned-rows;
    in property <[RecLine]> rc-standing-rows;
    in property <string> rc-limits;
    callback rc-request();
    callback rc-tab-changed(int);
    callback rc-mark(int, string);
    callback rc-ignore();
    callback rc-reset();
    callback rc-salary(int);
    callback rc-restore(int);
    callback rc-standing-select(int);
    callback rc-refresh();
    // ---- tags, splits, budgets, templates (tags_ui.rs; panels in tags_dialog.slint)
    in-out property <bool> tags-open: false;
    in property <[TagRow]> tg-rows;
    in property <[color]> tg-palette;
    in property <[string]> tg-merge-names;
    in property <string> tg-booking-title;
    in property <bool> tg-has-booking: false;
    in property <string> tg-status;
    in property <bool> tg-armed: false;
    in-out property <int> tg-selected: -1;
    in-out property <string> tg-name;
    in-out property <int> tg-color: -1;
    in-out property <int> tg-merge: 0;
    callback tags-request();
    callback tag-select(int);
    callback tag-create(string, int);
    callback tag-save(string, int);
    callback tag-delete();
    callback tag-move(int);
    callback tag-merge(int);
    callback tag-assign();
    callback tag-unassign();
    callback tag-clear-booking();
    in property <string> inspector-tags;
    in-out property <bool> splits-open: false;
    in property <string> sp-title;
    in property <string> sp-amount;
    in property <string> sp-remaining;
    in property <[string]> sp-category-names;
    in property <[SplitRow]> sp-rows;
    in property <string> sp-status;
    callback splits-request();
    callback split-amount(int, string);
    callback split-note(int, string);
    callback split-category(int, int);
    callback split-add();
    callback split-remove-row(int);
    callback split-fill(int);
    callback split-save();
    callback split-clear();
    in-out property <bool> budgets-open: false;
    in property <string> bg-month;
    in property <[BudgetRow]> bg-rows;
    in property <[string]> bg-category-names;
    in property <string> bg-status;
    in-out property <int> bg-category: 0;
    in-out property <string> bg-amount;
    callback budgets-request();
    callback budget-pick(int);
    callback budget-set(int, string);
    callback budget-clear(int);
    in-out property <bool> templates-open: false;
    in property <[TemplateRow]> tp-rows;
    in property <string> tp-status;
    in property <bool> tp-armed: false;
    in-out property <int> tp-selected: -1;
    in-out property <string> tp-name;
    in-out property <string> tp-recipient;
    in-out property <string> tp-iban;
    in-out property <string> tp-bic;
    in-out property <string> tp-amount;
    in-out property <string> tp-purpose;
    callback templates-request();
    callback template-select(int);
    callback template-new();
    callback template-save(string, string, string, string, string, string);
    callback template-delete();
    in-out property <bool> rules-open: false;
    in property <[RuleItem]> rule-items;
    in property <[string]> rule-category-names;
    in property <[string]> rule-field-labels;
    in property <[string]> rule-kind-labels;
    in-out property <int> rule-selected: -1;
    in-out property <string> rule-name;
    in-out property <string> rule-pattern;
    in-out property <int> rule-category: 0;
    in-out property <int> rule-field: 0;
    in-out property <int> rule-kind: 0;
    in-out property <bool> rule-enabled: true;
    in property <bool> rule-armed: false;
    in property <string> rule-status;
    callback rules-request();
    callback rule-select(int);
    callback rule-new();
    callback rule-save(string, string, int, int, int, bool);
    callback rule-delete();
    callback select-booking(int);
    callback set-category(int);
    callback set-checked(bool);
    callback save-note(string);
    callback apply-rules();
    callback privacy-changed();
    callback lock();
    callback import-file();
    callback transfer-submit(int, string, string, string, string);
    callback transfer-start();

    // account / category management, About, keyboard shortcuts
    in property <[color]> palette;
    in property <string> app-version;
    in-out property <bool> about-open: false;
    in-out property <bool> acct-open: false;
    in-out property <bool> acct-edit: false;
    in-out property <string> acct-name;
    in-out property <int> acct-color: -1;
    in property <bool> acct-archived: false;
    in property <bool> acct-armed: false;
    in property <string> acct-status;
    in-out property <bool> cat-open: false;
    in property <[CategoryRow]> cat-rows;
    in-out property <int> cat-selected: -1;
    in-out property <string> cat-name;
    in-out property <int> cat-color: -1;
    in-out property <bool> cat-sub: false;
    in property <bool> cat-armed: false;
    in property <string> cat-status;
    callback account-new();
    callback account-edit();
    callback account-save(string, int);
    callback account-archive();
    callback account-delete();
    callback categories-open();
    callback category-select(int);
    callback category-add(string, int, bool);
    callback category-save(string, int);
    callback category-delete();
    callback shortcut(string, bool) -> bool;
    in property <int> search-focus-tick: 0;
    public function refocus() { fs.focus(); }

    callback unlock();
    callback demo();
    callback select-account(int);
    callback sync();
    callback search-changed();
    callback bank-search(string);
    callback bank-add(int, string);
    callback tan-submit(string);
    callback tan-cancel();

    // PIN / TAN / PSD2 dialog; mode: "pin" | "code" | "redirect" | "push"
    in property <bool> tan-open: false;
    in property <string> tan-mode;
    in property <string> tan-title;
    in property <string> tan-message;
    in property <image> tan-image;
    in property <bool> tan-has-image: false;
    in-out property <string> tan-text;

    fs := FocusScope {
    capture-key-pressed(event) => {
        if (root.shortcut(event.text, event.modifiers.control)) { return accept; }
        reject
    }
    if !unlocked: VerticalLayout {
        alignment: center;
        spacing: 14px;
        padding: 40px;
        Text { text: "GiroCrab"; font-size: 36px; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
        Text {
            text: first-run ? "Neuen Tresor anlegen. Der Schlüssel liegt in der Windows-Anmeldeinformationsverwaltung."
                            : "Tresor entsperren (Schlüssel aus der Windows-Anmeldeinformationsverwaltung).";
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            Button { text: first-run ? "Tresor anlegen" : "Entsperren"; primary: true; clicked => { root.unlock(); } }
            Button { text: "Demo-Modus"; clicked => { root.demo(); } }
        }
        Text { text: root.message; color: Theme.negative; horizontal-alignment: center; wrap: word-wrap; }
    }

    if unlocked: HorizontalLayout {
        // ---- sidebar
        Rectangle {
            width: 292px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text { text: "GiroCrab"; font-size: 18px; font-weight: 700; color: Theme.text; }
                ListView {
                    vertical-stretch: 1;
                    for r in root.side-rows: Rectangle {
                        height: r.kind == 5 ? 68px : r.kind == 1 ? 26px : r.kind == 2 ? 22px : r.key == "all" ? 38px : r.progress >= 0 ? 40px : (r.kind == 3 && r.detail != "") ? 40px : 30px;
                        if r.kind == 5: VerticalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 6px;
                            Rectangle {
                                height: 28px;
                                border-radius: 7px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                HorizontalLayout {
                                    spacing: 0px;
                                    SegButton { text: "Gruppen"; checked: root.group-mode == 0; clicked => { root.group-mode = 0; root.side-controls-changed(); } }
                                    SegButton { text: "Banken"; checked: root.group-mode == 1; clicked => { root.group-mode = 1; root.side-controls-changed(); } }
                                    SegButton { text: "Kontoart"; checked: root.group-mode == 2; clicked => { root.group-mode = 2; root.side-controls-changed(); } }
                                }
                            }
                            Rectangle {
                                height: 28px;
                                border-radius: 7px;
                                border-width: 1px;
                                border-color: Theme.control-border;
                                background: Theme.surface;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    Icon { name: "search"; width: 13px; height: 13px; y: (parent.height - self.height) / 2; }
                                    TextInput {
                                        horizontal-stretch: 1;
                                        horizontal-alignment: left;
                                        text <=> root.side-query;
                                        font-size: 12px;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        edited => { root.side-controls-changed(); }
                                        Text { visible: parent.text == ""; x: 0px; width: parent.width; horizontal-alignment: left; text: "Konten filtern"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        if r.kind != 5: SideLine {
                            r: r;
                            active: root.side-selected == r.key;
                            clicked => { root.side-click(r.key); }
                            fold => { root.side-fold(r.key); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: 8px;
                    GhostButton {
                        text: "+ Konto / Bank";
                        clicked => {
                            root.add-status = "";
                            root.bank-search("");
                            root.add-open = true;
                        }
                    }
                    GhostButton { text: "Neues Konto"; clicked => { root.account-new(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
        }

        // ---- main pane
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            // toolbar
            HorizontalLayout {
                spacing: 8px;
                GhostButton { text: "Importieren …"; enabled: !root.busy; clicked => { root.import-file(); } }
                GhostButton { text: "Überweisung …"; enabled: !root.busy && root.transfer-accounts.length > 0; clicked => { root.transfer-start(); } }
                GhostButton { text: "Regeln anwenden"; enabled: !root.busy; clicked => { root.apply-rules(); } }
                GhostButton { text: "Kategorien"; clicked => { root.categories-open(); } }
                GhostButton { text: "Regeln …"; clicked => { root.rules-request(); } }
                GhostButton { text: "Tags …"; clicked => { root.tags-request(); } }
                GhostButton { text: "Gruppen …"; enabled: !root.busy; clicked => { GroupsState.request(); } }
                GhostButton { text: "Sachwerte …"; enabled: !root.busy; clicked => { AssetsState.request(); } }
                GhostButton { text: "Budgets …"; clicked => { root.budgets-request(); } }
                GhostButton { text: "Vorlagen …"; clicked => { root.templates-request(); } }
                GhostButton { text: "Wiederkehrend …"; clicked => { root.rc-request(); } }
                GhostButton { text: "Info"; clicked => { root.about-open = true; } }
                Rectangle { horizontal-stretch: 1; }
                PillToggle {
                    text: "Privatmodus";
                    checked <=> root.privacy;
                    toggled => { root.privacy-changed(); }
                }
                GhostButton { text: "Sperren"; clicked => { root.lock(); } }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
            if root.view-mode == 0: Rectangle {
                height: 88px;
                background: Theme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: root.selected-name == "" ? "Keine Konten" : root.selected-name;
                            font-size: 16px; font-weight: 700; color: Theme.text; overflow: elide;
                        }
                        Text { text: root.selected-balance; font-size: 24px; font-weight: 700; color: Theme.text; overflow: elide; }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        GhostButton {
                            y: (parent.height - self.height) / 2;
                            text: "Bearbeiten";
                            enabled: root.selected > 0 && !root.busy;
                            visible: root.selected > 0;
                            clicked => { root.account-edit(); }
                        }
                        Rectangle {
                            width: 130px;
                            height: 34px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 8px;
                            opacity: root.busy ? 0.6 : 1;
                            background: sync-ta.pressed ? Theme.primary.darker(0.2) : sync-ta.has-hover ? Theme.accent : Theme.primary;
                            sync-ta := TouchArea { enabled: !root.busy; clicked => { root.sync(); } }
                            Text {
                                text: root.busy ? "Bitte warten …" : "Jetzt abrufen";
                                color: #ffffff; font-size: 12px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            if root.sync-status != "": Text {
                text: root.sync-status; color: Theme.muted; font-size: 11px; wrap: word-wrap;
            }
            // filter bar
            if root.view-mode == 0: HorizontalLayout {
                spacing: 10px;
                search-edit := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Gegenpartei, Verwendungszweck, Notiz suchen";
                    text <=> root.search-text;
                    edited => { root.search-changed(); }
                }
                ChangeTrigger { width: 0px; height: 0px; tick: root.search-focus-tick; fire => { search-edit.focus(); } }
                ComboBox {
                    width: 150px;
                    model: ["Alle Umsätze", "Ungeprüft", "Geprüft", "Ausgaben", "Einnahmen"];
                    current-index <=> root.status-index;
                    selected => { root.search-changed(); }
                }
                PillToggle {
                    text: "Ohne Kategorie";
                    checked <=> root.uncategorized-only;
                    toggled => { root.search-changed(); }
                }
            }
            // dashboard cards above the bookings: cashflow chart and budgets
            if root.view-mode == 0: CashflowCard {
                height: 190px;
                bars: root.cashflow-bars;
                ticks: root.cashflow-ticks;
                period <=> root.cashflow-period;
                changed => { root.cashflow-changed(); }
            }
            if root.view-mode == 0: Rectangle {
                height: root.budget-lines.length == 0 ? 56px : 46px + min(root.budget-lines.length, 4) * 32px;
                background: Theme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text { text: root.budget-title; color: Theme.text; font-size: 14px; font-weight: 700; }
                    if root.budget-lines.length == 0: Text { text: "Keine Ausgaben in diesem Monat"; color: Theme.muted; font-size: 11px; }
                    for l[i] in root.budget-lines: BudgetBar { l: l; visible: i < 4; height: i < 4 ? 30px : 0px; }
                }
            }
            if root.view-mode == 0: Rectangle {
                vertical-stretch: 1;
                    if root.days.length == 0: Text {
                        text: (root.search-text == "" && !root.uncategorized-only && root.status-index == 0) ? "Keine Umsätze" : "Keine Treffer";
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ListView {
                        for d in root.days: DayCard {
                            day: d;
                            selected-booking: root.selected-booking;
                            select(id) => { root.select-booking(id); }
                        }
                    }
                }
            // ---- data pane: depot / Sachwerte, Vermögen, Geplant, Lastschriften, Belege
            if root.view-mode != 0: VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                Rectangle {
                    height: root.view-mode == 1 || root.view-mode == 2 ? 88px : 56px;
                    background: Theme.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            Text { text: root.view-title; font-size: root.view-mode == 1 || root.view-mode == 2 ? 16px : 18px; font-weight: 700; color: Theme.text; overflow: elide; }
                            if root.view-mode == 1 || root.view-mode == 2: Text { text: root.view-total; font-size: 24px; font-weight: 700; color: Theme.text; overflow: elide; }
                        }
                        if root.view-mode == 1: VerticalLayout {
                            alignment: center;
                            ComboBox {
                                                            width: 190px;
                                model: root.period-labels;
                                current-index <=> root.period-index;
                                selected => { root.view-changed(); }
                            }
                        }
                        if root.view-mode == 3: VerticalLayout {
                            alignment: center;
                            ComboBox {
                                                            width: 190px;
                                model: root.interval-labels;
                                current-index <=> root.interval-index;
                                selected => { root.view-changed(); }
                            }
                        }
                        if root.view-mode == 5: HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                ComboBox {
                                                                    width: 170px;
                                    model: root.doc-accounts;
                                    current-index <=> root.doc-account-index;
                                }
                            }
                            GhostButton { y: (parent.height - self.height) / 2; text: "Datei hinzufügen …"; enabled: !root.busy && root.doc-accounts.length > 0; clicked => { root.doc-attach(); } }
                        }
                    }
                }
                if root.view-note != "": Text { text: root.view-note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                if root.view-mode == 2: HorizontalLayout {
                    spacing: 6px;
                    for label[i] in ["Alles", "Cash", "Wertpapiere", "Sachwerte"]: SegButton {
                        text: label;
                        checked: root.wealth-tab == i;
                        clicked => { root.wealth-tab = i; root.view-changed(); }
                    }
                    Rectangle { horizontal-stretch: 2; }
                }
                if root.view-mode == 1: HorizontalLayout {
                    spacing: 10px;
                    for k in root.kpis: KpiCard { k: k; }
                }
                if (root.view-mode == 1 || root.view-mode == 2) && root.shares.length > 0: Rectangle {
                    height: 44px + root.shares.length * 26px;
                    background: Theme.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 4px;
                        Text { text: "Zusammensetzung"; color: Theme.muted; font-size: 11px; font-weight: 700; }
                        for s in root.shares: ShareBarLine { s: s; }
                    }
                }
                if root.view-mode == 1: HorizontalLayout {
                    spacing: 6px;
                    SegButton { text: "Positionen"; checked: root.depot-tab == 0; clicked => { root.depot-tab = 0; root.view-changed(); } }
                    SegButton { text: "Aktivitäten"; checked: root.depot-tab == 1; clicked => { root.depot-tab = 1; root.view-changed(); } }
                    Rectangle { horizontal-stretch: 4; }
                }
                if root.view-mode == 5: HorizontalLayout {
                    spacing: 8px;
                    GhostButton { text: "Öffnen"; enabled: root.doc-selected && !root.busy; clicked => { root.doc-open(); } }
                    GhostButton { text: "Mit Umsatz verknüpfen …"; enabled: root.doc-selected && !root.busy; clicked => { root.doc-link-open(); } }
                    GhostButton { text: "Verknüpfung lösen"; enabled: root.doc-linked && !root.busy; clicked => { root.doc-unlink(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.view-status != "": Text { text: root.view-status; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    VerticalLayout {
                        TableHeader { columns: root.table-columns; }
                        Rectangle {
                            vertical-stretch: 1;
                            if root.table-rows.length == 0: Text { text: root.table-empty; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                            ListView {
                                for r[i] in root.table-rows: TableLine {
                                    data: r;
                                    clickable: root.view-mode == 5;
                                    active: root.view-mode == 5 && root.table-selected == i;
                                    clicked => { if (root.view-mode == 5) { root.table-select(i); } }
                                }
                            }
                        }
                    }
                }
            }
                }
                if root.view-mode == 0: Rectangle {
                    width: 310px;
                    if !root.has-inspector: Rectangle {
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text { text: "Keine Buchung ausgewählt"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.has-inspector: VerticalLayout {
                        spacing: 10px;
                        // booking header
                        Rectangle {
                            height: 150px;
                            background: Theme.surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    MerchantAvatar {
                                        size: 38px;
                                        logo: root.inspector.logo;
                                        has-logo: root.inspector.has-logo;
                                        monogram: root.inspector.monogram;
                                        tint: root.inspector.tint;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: root.inspector.counterparty; font-size: 14px; font-weight: 700; color: Theme.text; overflow: elide; }
                                        Text { text: root.inspector.subtitle; font-size: 11px; color: Theme.muted; overflow: elide; }
                                    }
                                }
                                Text { text: root.inspector.amount; font-size: 24px; font-weight: 700; color: Theme.text; overflow: elide; }
                                HorizontalLayout {
                                    Text { text: "Buchung " + root.inspector.booking-date; font-size: 11px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: "Geprüft"; font-size: 12px; color: Theme.text; vertical-alignment: center; }
                                    Switch {
                                        checked <=> root.inspector-checked;
                                        enabled: !root.inspector.read-only;
                                        toggled => { root.set-checked(root.inspector-checked); }
                                    }
                                }
                            }
                        }
                        // note
                        Rectangle {
                            height: 138px;
                            background: Theme.surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalLayout {
                                    Text { text: "Notiz"; font-size: 12px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; }
                                    GhostButton { text: "Speichern"; enabled: !root.inspector.read-only; clicked => { root.save-note(root.note-text); } }
                                }
                                TextEdit {
                                    text <=> root.note-text;
                                    enabled: !root.inspector.read-only;
                                    vertical-stretch: 1;
                                }
                            }
                        }
                        // tags and split
                        Rectangle {
                            height: 44px;
                            background: Theme.surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 6px;
                                Text { text: root.inspector-tags == "" ? "Keine Tags" : root.inspector-tags; font-size: 11px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                GhostButton { text: "Tags …"; enabled: !root.inspector.read-only; clicked => { root.tags-request(); } }
                                GhostButton { text: "Aufteilen …"; enabled: !root.inspector.read-only; clicked => { root.splits-request(); } }
                            }
                        }
                        // recurring
                        Rectangle {
                            height: 44px;
                            background: Theme.surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text { text: "Wiederkehrend"; font-size: 12px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: root.inspector.recurring ? "Erkannt" : "Nicht erkannt"; font-size: 11px; color: root.inspector.recurring ? Theme.positive : Theme.muted; vertical-alignment: center; }
                                GhostButton { text: "Ändern …"; enabled: !root.inspector.read-only; clicked => { root.rc-request(); } }
                            }
                        }
                        // category tiles
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text { text: "Kategorie"; font-size: 12px; font-weight: 700; color: Theme.text; }
                                ScrollView {
                                    vertical-stretch: 1;
                                    content-height: ceil(root.category-tiles.length / 2) * 38px;
                                    for t[i] in root.category-tiles: Rectangle {
                                        x: mod(i, 2) * (parent.width / 2);
                                        y: floor(i / 2) * 38px;
                                        width: parent.width / 2 - 4px;
                                        height: 32px;
                                        property <bool> on: root.inspector-category == t.index;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: on ? t.color : Theme.border;
                                        background: on ? t.color.with-alpha(0.2) : tile-ta.has-hover ? Theme.text.with-alpha(0.05) : transparent;
                                        tile-ta := TouchArea {
                                            enabled: !root.inspector.read-only;
                                            clicked => { root.inspector-category = t.index; root.set-category(t.index); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: t.color; }
                                            Text { text: t.name; font-size: 11px; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                        }
                                    }
                                }
                                GhostButton { text: "Regeln anwenden"; enabled: !root.busy; clicked => { root.apply-rules(); } }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- add bank dialog (overlay)
    if add-open: Rectangle {
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: min(520px, parent.width - 32px);
            height: min(520px, parent.height - 32px);
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "Bank / Konto hinzufügen"; font-size: 18px; font-weight: 700; color: Theme.text; }
                LineEdit {
                    placeholder-text: "Bankname oder BLZ suchen";
                    edited(t) => { root.bank-search(t); }
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 8px;
                    clip: true;
                    ListView {
                        for h[i] in root.bank-hits: Rectangle {
                            height: 48px;
                            background: root.bank-choice == i ? Theme.accent.with-alpha(0.18) : transparent;
                            TouchArea { clicked => { root.bank-choice = i; } }
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: center;
                                Text { text: h.name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                Text { text: h.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
                            }
                        }
                    }
                }
                login := LineEdit {
                    placeholder-text: "Zugangskennung / Login (bei der Demo-Bank leer lassen)";
                }
                Text {
                    text: "PIN und TAN werden erst beim Abruf abgefragt, nur im Speicher gehalten und nie gespeichert.";
                    color: Theme.muted; font-size: 11px; wrap: word-wrap;
                }
                if root.add-status != "": Text { text: root.add-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Abbrechen"; clicked => { root.add-open = false; } }
                    Button {
                        text: root.add-busy ? "Bitte warten …" : "Hinzufügen";
                        primary: true;
                        enabled: root.bank-choice >= 0 && !root.add-busy;
                        clicked => { root.bank-add(root.bank-choice, login.text); }
                    }
                }
            }
        }
    }

    // ---- SEPA transfer dialog (overlay)
    if transfer-open: Rectangle {
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: min(480px, parent.width - 32px);
            height: tr-col.preferred-height + 4px;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            tr-col := VerticalLayout {
                padding: 18px;
                spacing: 8px;
                Text { text: "Überweisung"; font-size: 18px; font-weight: 700; color: Theme.text; }
                Text { text: "Von Konto"; font-size: 11px; color: Theme.muted; }
                tr-account := ComboBox { model: root.transfer-accounts; current-index: 0; }
                tr-name := LineEdit { placeholder-text: "Empfänger (Name)"; }
                tr-iban := LineEdit { placeholder-text: "IBAN des Empfängers"; }
                tr-amount := LineEdit { placeholder-text: "Betrag in EUR, z. B. 12,50"; }
                tr-purpose := LineEdit { placeholder-text: "Verwendungszweck (max. 140 Zeichen)"; }
                Text {
                    text: "PIN und TAN werden erst beim Senden abgefragt und nie gespeichert.";
                    color: Theme.muted; font-size: 11px; wrap: word-wrap;
                }
                if root.transfer-status != "": Text { text: root.transfer-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Abbrechen"; clicked => { root.transfer-open = false; } }
                    Button {
                        text: "Senden";
                        primary: true;
                        clicked => { root.transfer-submit(tr-account.current-index, tr-name.text, tr-iban.text, tr-amount.text, tr-purpose.text); }
                    }
                }
            }
        }
    }

    // ---- PIN / TAN dialog (overlay); the input is cleared as soon as it is handed over
    if tan-open: Rectangle {
        background: #000000aa;
        TouchArea { }
        Rectangle {
            width: min(460px, parent.width - 32px);
            height: tan-col.preferred-height + 4px;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            tan-col := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: root.tan-title; font-size: 18px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                Text { text: root.tan-message; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                if root.tan-has-image: Image { source: root.tan-image; height: 200px; image-fit: contain; }
                if root.tan-mode == "push": Text {
                    text: "Warte auf Freigabe in der Bank-App …";
                    color: Theme.text; font-size: 13px; horizontal-alignment: center;
                }
                if root.tan-mode != "push" && root.tan-mode != "confirm": LineEdit {
                    text <=> root.tan-text;
                    input-type: root.tan-mode == "pin" ? InputType.password : InputType.text;
                    placeholder-text: root.tan-mode == "pin" ? "PIN" : root.tan-mode == "redirect" ? "Adresse oder Code aus dem Browser einfügen" : "TAN";
                    accepted(t) => { root.tan-submit(t); root.tan-text = ""; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Abbrechen"; clicked => { root.tan-text = ""; root.tan-cancel(); } }
                    if root.tan-mode != "push": Button {
                        text: root.tan-mode == "confirm" ? "Trotzdem senden" : "Weiter";
                        primary: true;
                        clicked => { root.tan-submit(root.tan-text); root.tan-text = ""; }
                    }
                }
            }
        }
    }

    // ---- account dialog: create / edit / archive / delete
    if acct-open: Dialog {
        dialog-width: 460px;
        Text { text: root.acct-edit ? "Konto bearbeiten" : "Neues Konto"; font-size: 18px; font-weight: 700; color: Theme.text; }
        if !root.acct-edit: Text {
            text: "Ein Konto ohne Bankanbindung, z. B. Bargeld oder Sachwerte. Umsätze lassen sich per Import ergänzen.";
            color: Theme.muted; font-size: 11px; wrap: word-wrap;
        }
        LineEdit {
            placeholder-text: "Kontoname";
            text <=> root.acct-name;
            accepted => { root.account-save(root.acct-name, root.acct-color); }
        }
        Text { text: "Farbe"; font-size: 11px; color: Theme.muted; }
        Swatches { colors: root.palette; choice <=> root.acct-color; }
        if root.acct-status != "": Text { text: root.acct-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
        if root.acct-edit: Text {
            text: root.acct-archived ? "Archiviert: wird beim Abruf übersprungen und zählt nicht zur Summe. Löschen entfernt Umsätze, Belege und Bestände endgültig."
                                     : "Archivieren behält alle Umsätze, stoppt aber den Abruf. Gelöscht werden kann nur ein archiviertes Konto.";
            color: Theme.muted; font-size: 11px; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            if root.acct-edit: Button { text: root.acct-archived ? "Reaktivieren" : "Archivieren"; clicked => { root.account-archive(); } }
            if root.acct-edit && root.acct-archived: Button { text: root.acct-armed ? "Wirklich löschen?" : "Löschen"; clicked => { root.account-delete(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Abbrechen"; clicked => { root.acct-open = false; root.refocus(); } }
            Button { text: "Speichern"; primary: true; clicked => { root.account-save(root.acct-name, root.acct-color); } }
        }
    }

    // ---- category dialog: create / rename / recolour / delete
    if cat-open: Dialog {
        dialog-width: 560px;
        Text { text: "Kategorien"; font-size: 18px; font-weight: 700; color: Theme.text; }
        Rectangle {
            height: 220px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            clip: true;
            if root.cat-rows.length == 0: Text { text: "Noch keine Kategorien"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
            ListView {
                for r[i] in root.cat-rows: Rectangle {
                    height: 32px;
                    background: root.cat-selected == i ? Theme.accent.with-alpha(0.18) : transparent;
                    TouchArea { clicked => { root.category-select(i); } }
                    HorizontalLayout {
                        padding-left: 12px + r.depth * 18px;
                        padding-right: 12px;
                        spacing: 8px;
                        VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: r.color; } }
                        Text { text: r.name; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
        LineEdit { placeholder-text: "Name der Kategorie"; text <=> root.cat-name; }
        Text { text: "Farbe"; font-size: 11px; color: Theme.muted; }
        Swatches { colors: root.palette; choice <=> root.cat-color; }
        CheckBox { text: "Neue Kategorie als Unterkategorie der Auswahl anlegen"; checked <=> root.cat-sub; enabled: root.cat-selected >= 0; }
        if root.cat-status != "": Text { text: root.cat-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
        Text {
            text: "Löschen entfernt auch Unterkategorien und deren Regeln; die Umsätze bleiben, werden aber unkategorisiert.";
            color: Theme.muted; font-size: 11px; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Neu anlegen"; clicked => { root.category-add(root.cat-name, root.cat-color, root.cat-sub); } }
            Button { text: "Speichern"; enabled: root.cat-selected >= 0; clicked => { root.category-save(root.cat-name, root.cat-color); } }
            Button { text: root.cat-armed ? "Wirklich löschen?" : "Löschen"; enabled: root.cat-selected >= 0; clicked => { root.category-delete(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Schließen"; primary: true; clicked => { root.cat-open = false; root.refocus(); } }
        }
    }

    // ---- rules dialog: create / edit / delete auto-categorisation rules
    if rules-open: Dialog {
        dialog-width: 640px;
        Text { text: "Regeln"; font-size: 18px; font-weight: 700; color: Theme.text; }
        Text { text: "Eine Regel ordnet passende Umsätze einer Kategorie zu. Angewendet wird sie mit „Regeln anwenden“."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        Rectangle {
            height: 190px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            clip: true;
            if root.rule-items.length == 0: Text { text: "Noch keine Regeln"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
            ListView {
                for r[i] in root.rule-items: Rectangle {
                    height: 44px;
                    background: root.rule-selected == i ? Theme.accent.with-alpha(0.18) : transparent;
                    TouchArea { clicked => { root.rule-select(i); } }
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: r.title; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: r.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                }
            }
        }
        LineEdit { placeholder-text: "Name (optional)"; text <=> root.rule-name; }
        LineEdit { placeholder-text: "Suchmuster, z. B. REWE|EDEKA"; text <=> root.rule-pattern; }
        Text { text: "Kategorie"; font-size: 11px; color: Theme.muted; }
        ComboBox { model: root.rule-category-names; current-index <=> root.rule-category; }
        HorizontalLayout {
            spacing: 8px;
            ComboBox { horizontal-stretch: 1; model: root.rule-field-labels; current-index <=> root.rule-field; }
            ComboBox { horizontal-stretch: 1; model: root.rule-kind-labels; current-index <=> root.rule-kind; }
        }
        CheckBox { text: "Regel aktiv"; checked <=> root.rule-enabled; }
        if root.rule-status != "": Text { text: root.rule-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Neue Regel"; clicked => { root.rule-new(); } }
            Button { text: root.rule-selected >= 0 ? "Speichern" : "Anlegen"; primary: true; clicked => { root.rule-save(root.rule-name, root.rule-pattern, root.rule-category, root.rule-field, root.rule-kind, root.rule-enabled); } }
            Button { text: root.rule-armed ? "Wirklich löschen?" : "Löschen"; enabled: root.rule-selected >= 0; clicked => { root.rule-delete(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Schließen"; clicked => { root.rules-open = false; root.refocus(); } }
        }
    }

    // ---- account groups and account settings (groups_ui.rs; panel in groups_dialog.slint)
    if GroupsState.open: Dialog {
        dialog-width: 860px;
        GroupsPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: Theme.accent; negative: Theme.negative;
            close() => { GroupsState.open = false; root.refocus(); }
        }
    }

    // ---- Sachwerte, Darlehen, Klassifizierung (assets_loans_ui.rs; panel in assets_loans_dialog.slint)
    if AssetsState.open: Dialog {
        dialog-width: 940px;
        AssetsLoansPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: Theme.accent; negative: Theme.negative;
            close() => { AssetsState.open = false; root.refocus(); }
        }
    }

    // ---- tags / splits / budgets / templates dialogs
    if tags-open: Dialog {
        dialog-width: 600px;
        TagsPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: Theme.accent; negative: Theme.negative;
            tags: root.tg-rows; palette: root.tg-palette; merge-names: root.tg-merge-names;
            booking-title: root.tg-booking-title; has-booking: root.tg-has-booking;
            status: root.tg-status; armed: root.tg-armed;
            selected <=> root.tg-selected; name <=> root.tg-name; color-choice <=> root.tg-color; merge-index <=> root.tg-merge;
            select(i) => { root.tag-select(i); }
            create(n, c) => { root.tag-create(n, c); }
            save(n, c) => { root.tag-save(n, c); }
            remove() => { root.tag-delete(); }
            move(d) => { root.tag-move(d); }
            merge(i) => { root.tag-merge(i); }
            assign() => { root.tag-assign(); }
            unassign() => { root.tag-unassign(); }
            clear-booking() => { root.tag-clear-booking(); }
            close() => { root.tags-open = false; root.refocus(); }
        }
    }
    if splits-open: Dialog {
        dialog-width: 640px;
        SplitsPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; negative: Theme.negative;
            booking-title: root.sp-title; booking-amount: root.sp-amount; remaining: root.sp-remaining;
            category-names: root.sp-category-names; rows: root.sp-rows; status: root.sp-status;
            amount-edited(i, t) => { root.split-amount(i, t); }
            note-edited(i, t) => { root.split-note(i, t); }
            category-picked(i, c) => { root.split-category(i, c); }
            add-row() => { root.split-add(); }
            remove-row(i) => { root.split-remove-row(i); }
            fill-rest(i) => { root.split-fill(i); }
            save() => { root.split-save(); }
            remove-split() => { root.split-clear(); }
            close() => { root.splits-open = false; root.refocus(); }
        }
    }
    if budgets-open: Dialog {
        dialog-width: 560px;
        BudgetsPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: Theme.accent; negative: Theme.negative;
            month-title: root.bg-month; rows: root.bg-rows; category-names: root.bg-category-names; status: root.bg-status;
            category <=> root.bg-category; amount <=> root.bg-amount;
            pick(i) => { root.budget-pick(i); }
            set(c, a) => { root.budget-set(c, a); }
            clear(c) => { root.budget-clear(c); }
            close() => { root.budgets-open = false; root.refocus(); }
        }
    }
    if templates-open: Dialog {
        dialog-width: 600px;
        TemplatesPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: Theme.accent; negative: Theme.negative;
            rows: root.tp-rows; status: root.tp-status; armed: root.tp-armed;
            selected <=> root.tp-selected; name <=> root.tp-name; recipient <=> root.tp-recipient;
            iban <=> root.tp-iban; bic <=> root.tp-bic; amount <=> root.tp-amount; purpose <=> root.tp-purpose;
            select(i) => { root.template-select(i); }
            new-template() => { root.template-new(); }
            save(a, b, c, d, e, f) => { root.template-save(a, b, c, d, e, f); }
            remove() => { root.template-delete(); }
            close() => { root.templates-open = false; root.refocus(); }
        }
    }

    // ---- recurring / planned / salary dialog
    if rc-open: Dialog {
        dialog-width: 640px;
        RecurringPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: Theme.accent; negative: Theme.negative;
            tab <=> root.rc-tab; status: root.rc-status; salary-cycle: root.rc-salary-cycle;
            has-booking: root.rc-has-booking; booking-title: root.rc-booking-title; series-text: root.rc-series-text;
            salary-state: root.rc-salary-state; can-salary: root.rc-can-salary; has-series: root.rc-has-series;
            interval-names: root.rc-interval-names; interval-index <=> root.rc-interval; custom-dates <=> root.rc-custom-dates;
            month-summary: root.rc-month-summary; month-rows: root.rc-month-rows; ignored-rows: root.rc-ignored-rows;
            planned-summary: root.rc-planned-summary; planned-rows: root.rc-planned-rows;
            standing-rows: root.rc-standing-rows; limits-text: root.rc-limits;
            tab-changed(t) => { root.rc-tab-changed(t); }
            mark(i, d) => { root.rc-mark(i, d); }
            ignore() => { root.rc-ignore(); }
            reset() => { root.rc-reset(); }
            salary(c) => { root.rc-salary(c); }
            restore(i) => { root.rc-restore(i); }
            standing-select(i) => { root.rc-standing-select(i); }
            refresh() => { root.rc-refresh(); }
            close() => { root.rc-open = false; root.refocus(); }
        }
    }

    // ---- link a document to a booking
    if link-open: Dialog {
        dialog-width: 560px;
        Text { text: "Beleg mit Umsatz verknüpfen"; font-size: 18px; font-weight: 700; color: Theme.text; }
        LineEdit {
            placeholder-text: "Umsatz suchen (Gegenpartei, Verwendungszweck)";
            text <=> root.link-query;
            edited(t) => { root.link-search(t); }
        }
        Rectangle {
            height: 240px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            clip: true;
            if root.link-results.length == 0: Text { text: "Keine Umsätze"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
            ListView {
                for r[i] in root.link-results: TableLine {
                    data: r;
                    clickable: true;
                    clicked => { root.link-pick(i); }
                }
            }
        }
        if root.link-status != "": Text { text: root.link-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout { alignment: end; Button { text: "Abbrechen"; clicked => { root.link-open = false; root.refocus(); } } }
    }

    // ---- About
    if about-open: Dialog {
        dialog-width: 380px;
        Text { text: "GiroCrab"; font-size: 22px; font-weight: 700; color: Theme.text; }
        Text { text: "Version " + root.app-version; font-size: 13px; color: Theme.text; }
        Text { text: "Freie Software unter GPL-3.0-or-later. Der Tresor liegt verschlüsselt auf diesem Rechner."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        Text { text: "Tastenkürzel: Strg+F Suche · Strg+L Sperren · Strg+R / F5 Abrufen · Strg+I Importieren · Strg+N Überweisung · Esc Dialog schließen"; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout { alignment: end; Button { text: "Schließen"; primary: true; clicked => { root.about-open = false; root.refocus(); } } }
    }
    }
}
